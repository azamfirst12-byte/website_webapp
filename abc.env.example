# ── Database: PostgreSQL (free: Neon via Vercel → Storage → Create Database → Neon) ──
# Tables are created automatically on the first request. The pooled URL (…-pooler…) is best on Vercel.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Gemini (server-side only; never exposed to the browser) ─────────────
GEMINI_API_KEY=
# Live API model for voice (WebSockets). Model ids change often — check https://ai.google.dev/gemini-api/docs/models
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Text model: text-chat channel, conversation summaries and next actions.
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Default prebuilt voice (Puck, Kore, Charon, Aoede, Fenrir, Leda, Orus, Zephyr…). The Developer area can override it per workspace.
GEMINI_VOICE=Puck

# Max voice sessions one IP may start per hour (protects your credits). 1 is very strict for testing.
LIVE_SESSIONS_PER_IP_PER_HOUR=12
# Max text-chat messages one IP may send per hour.
TEXT_MESSAGES_PER_IP_PER_HOUR=120

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://xynex-vision-rael.vercel.app
# Business WhatsApp (digits only, with country code) — used for human hand-over. Optional.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=
# Time zone for dashboards, follow-up dates and daily/weekly/monthly charts (IANA name)
STORE_TIMEZONE=Asia/Karachi

# ── Admin (business dashboard at /admin) ─────────────────────────────────
# Signs admin + developer login cookies. Any long random string (32+ characters). Changing it signs everyone out.
AUTH_SECRET=
# Used ONCE to create the first admin (role: admin). Afterwards manage staff in /admin/team.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_EMAIL=you@example.com
# Optional instead of ADMIN_PASSWORD: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Lets people create a staff account on the login page with this code (they get the "sales" role). Empty = off.
ADMIN_INVITE_CODE=
# Show staff user-ID chips on the login page: on / off (default: only in development)
ADMIN_SHOW_ACCOUNTS=

# ── Developer Control Center (/developer) — SEPARATE accounts from admin ──
# Used ONCE to create the first developer account. Admin accounts never get developer access.
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=change-this-too-a-different-password
DEVELOPER_EMAIL=
# Optional: npm run hash-password -- "pw" and paste the hash here instead of DEVELOPER_PASSWORD
DEVELOPER_PASSWORD_HASH=

# ── Email (password resets + sales-team notifications). Gmail: App Password with 2-Step Verification.
# Leave empty in development: emails are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Xynex Vision <you@example.com>
# Where new-lead / booking / hand-over alerts go (comma-separated). Defaults to ADMIN_EMAIL.
SALES_NOTIFY_EMAIL=

# ── Demo data: loaded automatically into a brand-new database (clearly labelled DEMO). off = never.
SEED_DEMO_DATA=on

# ── Desktop / Tablet / Mobile view switcher: on = everyone, off = never (default: dev + signed-in staff)
NEXT_PUBLIC_DEVICE_PREVIEW=
